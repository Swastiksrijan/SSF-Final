# Copy this file to `.env` for local development.
# The backend (backend_node) listens on port 5099 (see backend_node/.env).
# Without VITE_BACKEND_URL the frontend defaults to http://localhost:5000 and
# Digital Office saves fail with "Unable to save / सहेज नहीं सका".
VITE_BACKEND_URL=http://localhost:5099
